CREATE MEMORY TABLE PUBLIC.APP_USER(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,GOOGLE_SUB VARCHAR(255) NOT NULL,EMAIL VARCHAR(320) NOT NULL,NAME VARCHAR(255),CREATED_AT TIMESTAMP NOT NULL,CONSTRAINT UK_APP_USER_GOOGLE_SUB UNIQUE(GOOGLE_SUB))
