{
	"manifest_version": 3,
	"name": "Link Shortener",
	"version": "1.0.0",
	"description": "Acorta la página actual con un clic y muestra el enlace corto y su código QR.",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "Acortar esta página",
		"default_popup": "popup/popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_ui": {
		"page": "options/options.html",
		"open_in_tab": true
	},
	"permissions": ["activeTab", "storage"],
	"optional_host_permissions": ["http://*/*", "https://*/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "link-shortener@tp-pp6.local",
			"strict_min_version": "128.0"
		}
	}
}
